    <ns0:Folder>
      <ns0:name>Países e Fronteiras</ns0:name>
      <ns0:Placemark>
        <ns0:name>Fronteira Brasil - Colômbia</ns0:name>
        <ns0:styleUrl>#country-border</ns0:styleUrl>
        <ns0:description>Segmento amazônico da fronteira terrestre entre o Brasil e a Colômbia.</ns0:description>
        <ns0:LineString>
          <ns0:tessellate>1</ns0:tessellate>
          <ns0:coordinates>-70.027000,4.215000,0
-69.646000,3.839000,0
-69.348000,3.366000,0
-68.815000,2.712000,0
-67.871000,2.082000,0
-67.361000,1.823000,0
-66.876000,1.176000,0
-66.325000,0.902000,0</ns0:coordinates>
        </ns0:LineString>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Fronteira Brasil - Bolívia (Corredor Central)</ns0:name>
        <ns0:styleUrl>#country-border</ns0:styleUrl>
        <ns0:description>Trecho estratégico que conecta Corumbá (MS) a Guajará-Mirim (RO) pela fronteira boliviana.</ns0:description>
        <ns0:LineString>
          <ns0:tessellate>1</ns0:tessellate>
          <ns0:coordinates>-57.650000,-19.000000,0
-58.100000,-18.100000,0
-59.250000,-17.400000,0
-60.120000,-16.400000,0
-62.100000,-11.020000,0</ns0:coordinates>
        </ns0:LineString>
      </ns0:Placemark>
    </ns0:Folder>
    <ns0:Folder>
      <ns0:name>Capitais e Cidades</ns0:name>
      <ns0:Placemark>
        <ns0:name>Brasília</ns0:name>
        <ns0:styleUrl>#city-capital</ns0:styleUrl>
        <ns0:description>Capital federal e centro de comando político do Brasil.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-47.882500,-15.794200,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Manaus</ns0:name>
        <ns0:styleUrl>#city-major</ns0:styleUrl>
        <ns0:description>Capital amazônica, polo logístico fluvial e aéreo para operações na Amazônia Ocidental.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-60.021700,-3.119000,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Boa Vista</ns0:name>
        <ns0:styleUrl>#city-major</ns0:styleUrl>
        <ns0:description>Capital de Roraima, próxima às fronteiras com a Venezuela e Guiana.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-60.675300,2.823500,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Rio de Janeiro</ns0:name>
        <ns0:styleUrl>#city-major</ns0:styleUrl>
        <ns0:description>Centro urbano costeiro com capacidade industrial e logística naval.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-43.209600,-22.903500,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Tabatinga</ns0:name>
        <ns0:styleUrl>#city-major</ns0:styleUrl>
        <ns0:description>Município trinacional no extremo oeste do Amazonas, porta de entrada para operações conjuntas com Colômbia e Peru.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-69.938600,-4.231900,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
    </ns0:Folder>
    <ns0:Folder>
      <ns0:name>Regiões e Zonas Estratégicas</ns0:name>
      <ns0:Placemark>
        <ns0:name>Calha Norte</ns0:name>
        <ns0:styleUrl>#region-zone</ns0:styleUrl>
        <ns0:description>Zona estratégica de vigilância na fronteira norte, abrangendo bases do Exército e comunidades ribeirinhas.</ns0:description>
        <ns0:Polygon>
          <ns0:outerBoundaryIs>
            <ns0:LinearRing>
              <ns0:coordinates>-54.000000,3.000000,0
-58.000000,3.800000,0
-60.500000,2.900000,0
-61.800000,2.500000,0
-63.000000,3.200000,0
-60.000000,5.000000,0
-56.000000,5.300000,0
-54.000000,3.000000,0</ns0:coordinates>
            </ns0:LinearRing>
          </ns0:outerBoundaryIs>
        </ns0:Polygon>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Sistema Guianense de Vigilância</ns0:name>
        <ns0:styleUrl>#region-zone</ns0:styleUrl>
        <ns0:description>Setor de monitoramento no escudo das Guianas, com foco em atividades ilícitas transfronteiriças.</ns0:description>
        <ns0:Polygon>
          <ns0:outerBoundaryIs>
            <ns0:LinearRing>
              <ns0:coordinates>-60.900000,4.300000,0
-59.500000,3.900000,0
-58.000000,4.200000,0
-58.500000,5.300000,0
-60.000000,5.700000,0
-60.900000,4.300000,0</ns0:coordinates>
            </ns0:LinearRing>
          </ns0:outerBoundaryIs>
        </ns0:Polygon>
      </ns0:Placemark>
    </ns0:Folder>
    <ns0:Folder>
      <ns0:name>Infraestrutura e Recursos</ns0:name>
      <ns0:Placemark>
        <ns0:name>Base Aérea de Anápolis (ALA 2)</ns0:name>
        <ns0:styleUrl>#infrastructure</ns0:styleUrl>
        <ns0:description>Base aérea estratégica para defesa do espaço aéreo central do Brasil.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-48.960400,-16.228700,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Porto de Santos</ns0:name>
        <ns0:styleUrl>#infrastructure</ns0:styleUrl>
        <ns0:description>Principal porto marítimo brasileiro, vital para a cadeia logística nacional.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-46.305800,-23.961800,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Usina Hidrelétrica de Itaipu</ns0:name>
        <ns0:styleUrl>#infrastructure</ns0:styleUrl>
        <ns0:description>Maior usina hidrelétrica binacional Brasil-Paraguai, essencial para segurança energética.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-54.588300,-25.408000,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
      <ns0:Placemark>
        <ns0:name>Centro de Lançamento de Alcântara</ns0:name>
        <ns0:styleUrl>#infrastructure</ns0:styleUrl>
        <ns0:description>Base aeroespacial próxima à linha do Equador, com importância para operações espaciais.</ns0:description>
        <ns0:Point>
          <ns0:coordinates>-44.372300,-2.370700,0</ns0:coordinates>
        </ns0:Point>
      </ns0:Placemark>
    </ns0:Folder>
    <ns0:Folder>
