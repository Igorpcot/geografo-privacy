        <ns0:styleUrl>#route-line</ns0:styleUrl>
        <ns0:description>Principal rota fluvial de transporte e abastecimento da Amazônia.</ns0:description>
        <ns0:LineString>
          <ns0:tessellate>1</ns0:tessellate>
          <ns0:coordinates>-58.150000,-3.140000,0
