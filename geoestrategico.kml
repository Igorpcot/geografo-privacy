        <ns0:description>Via terrestre fundamental para escoamento de grãos do Centro-Oeste aos portos do Pará.</ns0:description>
        <ns0:LineString>
          <ns0:tessellate>1</ns0:tessellate>
          <ns0:coordinates>-55.721000,-12.740000,0
-55.515000,-10.183000,0
-55.508000,-6.020000,0
-55.236000,-3.140000,0
